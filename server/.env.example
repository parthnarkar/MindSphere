# Example environment variables for MindSphere server
# Copy this file to `.env` and fill in real values. DO NOT commit real secrets to source control.

# Server port (optional)
PORT=5000

# Model configuration (optional)
# Example: "gemini-2.5-flash" or another model name supported by your API key
MODEL_NAME="gemini-2.5-flash"

# Google Generative AI API key (set when using model features)
# Replace with your real key in your local .env or in deployment environment variables
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# MongoDB connection string. Use a mongodb+srv:// URI if applicable.
# Example: mongodb+srv://<username>:<password>@cluster0.abcdef.mongodb.net/
MONGO_URI="your_mongo_connection_string_here"
MONGO_DB_NAME="your_database_name_here"

# Admin token used by certain admin routes (change to a strong random secret in production)
ADMIN_SUMMARY_TOKEN="change-me-to-a-strong-secret"

# NOTES:
# - Keep your real secret values out of the repository. Use a deployment provider's secret
#   store (Vercel Environment Variables, GitHub Secrets, etc.) for production.
# - If your Mongo URI uses DNS SRV (mongodb+srv://) you may need the `dnspython` package.

# Client environment example — DO NOT commit real secrets.
# Copy this file to `client/.env` and fill real values locally.
# For production, set these values in your host (Vercel/GitHub Secrets/etc.)

VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_STORAGE_BUCKET"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_AUTH_DOMAIN"
VITE_FIREBASE_MEASUREMENT_ID="YOUR_FIREBASE_MEASUREMENT_ID"

# Optional YouTube API key and playlist
VITE_YT_API_KEY="YOUR_YOUTUBE_API_KEY"
VITE_YT_PLAYLIST_ID="YOUR_YT_PLAYLIST_ID"

# Backend endpoints
VITE_API_BASE="http://localhost:5000"
VITE_DEPLOYED_BACKEND_URL="https://your-deployed-backend.example.com"

# Admin token (server-only tokens should live on server; if used client-side keep it minimal)
VITE_ADMIN_SUMMARY_TOKEN="CHANGE_ME_IN_DEPLOYMENT"

# Notes:
# - This example must NOT include real keys. Keep .env in .gitignore.
# - For web API keys, restrict them by HTTP referrer in the provider console.
# - For any server-side secret, use server environment variables / secret manager.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-firebase-app-id"

# YouTube API keys / playlist (optional)
VITE_YT_API_KEY="YOUR_YT_API_KEY"
VITE_YT_PLAYLIST_ID="YOUR_YT_PLAYLIST_ID"

# Local backend for development
VITE_API_BASE="http://localhost:5000"

# Deployed backend URL (set in deployment environment)
VITE_DEPLOYED_BACKEND_URL="https://your-deployed-backend.example.com"

# Admin token used by client to call admin-only endpoints (do NOT commit real token)
VITE_ADMIN_SUMMARY_TOKEN="change-this-in-deployment"

# NOTES:
# - This file is an example for development. Copy to `.env` (client/.env) and fill
#   in real values for local development. Do NOT commit real secrets to source control.
# - For Vite, env vars prefixed with VITE_ are exposed to client-side code. Keep
#   sensitive secrets out of client-side build for production. Use server-side
#   endpoints that authenticate and keep secrets on the server.
# - On Vercel, set these values in the Project > Settings > Environment Variables.
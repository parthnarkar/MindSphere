### Vite environment variables for MindSphere client
# HTTP API base (used by forumApi). In development point to your local server, in production use proxied /api or full URL
VITE_API_BASE="http://localhost:3001/api"

# Socket server base (used by useSocket). Use origin (no /api) e.g. http://localhost:3001
VITE_SOCKET_API_BASE="http://localhost:3001"

# Optional: deployed backend URL
VITE_DEPLOYED_BASE="https://your-backend.example.com"